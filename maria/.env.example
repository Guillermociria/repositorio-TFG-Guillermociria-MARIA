# Copy this file to .env and fill in the values.

# ── LLM providers ────────────────────────────────────────────────
# GEMINI_API_KEY is required (Gemini is the default provider).
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Django ───────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated lists
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# ── Database (Django data) ───────────────────────────────────────
# With docker-compose.local.yml, DB_HOST/DB_PORT are set by Compose.
DB_NAME=sprint_db
DB_USER=django
DB_PASSWORD=django123
DB_HOST=localhost
DB_PORT=5432

# ── Database (LangGraph checkpoints) ─────────────────────────────
# Optional outside Docker: defaults to the Django database above.
# LANGGRAPH_DB_URI=postgresql://langgraph:langgraph123@localhost:5432/langgraph
LANGGRAPH_DB_USER=langgraph
LANGGRAPH_DB_PASSWORD=langgraph123
LANGGRAPH_DB_NAME=langgraph

# Host port for the web app (docker-compose.local.yml)
WEB_PORT=8000

# ── Seeded accounts ──────────────────────────────────────────────
DEMO_USER=demo
DEMO_PASSWORD=demo1234
DEMO_USERS_PASSWORD=demo123

# ── Tests (Playwright / Locust) ──────────────────────────────────
DJANGO_BASE_URL=http://localhost:8000
PW_TEST_USER=pw_test
PW_TEST_PASS=PwPass123!
PERF_TEST_USER=test_perf
PERF_TEST_PASS=PerfPass123!
